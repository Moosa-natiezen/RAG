# ==============================================================================
# Enterprise Production RAG Pipeline - Environment Configuration Template
# ==============================================================================

# Application Environment
ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Security & RBAC (Change SECRET_KEY in production!)
SECRET_KEY=replace-with-a-secure-32-byte-hex-encoded-secret-key-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Neon PostgreSQL shared by Better Auth (Next.js) and FastAPI
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Better Auth (server-only; generate a random secret of at least 32 characters)
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# Vector Database (Qdrant primary / ChromaDB fallback)
VECTOR_DB_TYPE=qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=enterprise_knowledge_base
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Embeddings (OpenAI text-embedding-3-large, 3072 dims)
OPENAI_API_KEY=your-openai-api-key-here
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072

# Sparse Search (BM25)
BM25_PERSIST_PATH=./bm25_index.json

# Hybrid Retrieval & RRF
RETRIEVAL_LIMIT=100
RRF_K=60

# Cross-Encoder Re-ranking (Cohere Rerank v3)
COHERE_API_KEY=your-cohere-api-key-here
RERANKER_PROVIDER=cohere
RERANKER_MODEL=rerank-v3.0
RERANK_TOP_N=30
FINAL_TOP_K=5

# Hierarchical Chunking (tokens)
PARENT_CHUNK_SIZE=1000
CHILD_CHUNK_SIZE=250
CHILD_CHUNK_OVERLAP=50

# LLM Inference (GPT-4o or Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
